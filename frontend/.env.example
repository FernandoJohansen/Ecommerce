# Leave empty in dev — Vite proxies /api/* to http://localhost:8000 automatically.
# Set to your deployed backend URL in production (e.g. https://api.carolinaviapiana.com.br).
VITE_API_URL=

# Public key do Mercado Pago (par do MERCADO_PAGO_ACCESS_TOKEN do backend).
# Sem ela, a aba Cartão mostra "método indisponível".
VITE_MERCADO_PAGO_PUBLIC_KEY=
