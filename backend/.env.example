SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key

# For admin operations (viewing orders, managing products from the API)
# use the service role key instead:
# SUPABASE_KEY=your-service-role-key

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# Pix payment key (CPF, phone, email, or random key)
PIX_KEY=sua-chave-pix@email.com
PIX_BENEFICIARIO=Carolina Viapiana

# ── API Pix Sicredi (Sprint 6) ────────────────────────────────────────────────
# Credenciais OAuth2 geradas no Portal do Desenvolvedor Sicredi
# (APIs > Catálogo de APIs > API Recebimento > Pix > Certificados e Credenciais).
# Sem estes valores, os endpoints de cobrança PIX respondem 503 e o site cai no
# fluxo antigo (combinar pagamento pelo WhatsApp).
SICREDI_CLIENT_ID=
SICREDI_CLIENT_SECRET=
# Certificado assinado pelo Sicredi + chave privada (APLICACAO.KEY), em PEM.
# Se o portal entregou .CER binário (DER), converta:
#   openssl x509 -inform der -in certificado.cer -out certificado.pem
SICREDI_CERT_PATH=/caminho/para/certificado.pem
SICREDI_KEY_PATH=/caminho/para/aplicacao.key
# Opcional: cadeia completa Sicredi (CA extra para verificação TLS)
SICREDI_CA_PATH=
# Produção: https://api-pix.sicredi.com.br | Homologação: https://api-pix-h.sicredi.com.br
SICREDI_BASE_URL=https://api-pix.sicredi.com.br
# URL pública deste backend para o webhook de confirmação; o Sicredi notifica
# em {PIX_WEBHOOK_URL}/pix. Registre com PUT /api/pagamento/webhook (staff).
# Ex.: https://api.seudominio.com.br/api/pagamento/webhook
PIX_WEBHOOK_URL=
