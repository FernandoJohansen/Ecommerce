SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key

# For admin operations (viewing orders, managing products from the API)
# use the service role key instead:
# SUPABASE_KEY=your-service-role-key

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# URL pública do frontend — usada como redirect_to no e-mail de recuperação de
# senha (Supabase precisa desta URL na allowlist de redirecionamentos).
# Default: primeiro valor de ALLOWED_ORIGINS.
# FRONTEND_URL=https://your-production-domain.com

# Docs interativas da API (/docs, /redoc, /openapi.json). Off por padrão; em
# produção expõem toda a superfície da API sem auth. Ligar só em dev.
# ENABLE_API_DOCS=true

# ── Rate limit: IP real do cliente (anti-spoofing de X-Forwarded-For) ────────
# X-Forwarded-For é controlado pelo cliente. Configure UM dos dois conforme o
# deploy; sem configurar, usa o IP da conexão (default seguro).
#   - CDN que injeta o IP real num header próprio (Cloudflare: cf-connecting-ip):
# RATE_LIMIT_CLIENT_IP_HEADER=cf-connecting-ip
#   - Atrás de N proxies reversos que anexam ao XFF (Railway/Render ~ 1):
# RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# ── Token de pagamento (anti-IDOR nos endpoints públicos de pagamento) ───────
# Segredo do HMAC dos tokens devolvidos na criação do pedido. Opcional: sem
# valor, deriva do SUPABASE_KEY. Para um segredo próprio: openssl rand -hex 32
# PAYMENT_TOKEN_SECRET=
# Validade do token; precisa cobrir o ciclo do boleto (default 7 dias)
# PAYMENT_TOKEN_TTL_SEGUNDOS=604800

# ── Segurança dos webhooks ───────────────────────────────────────────────────
# Em produção, o webhook do Mercado Pago recusa notificações quando
# MERCADO_PAGO_WEBHOOK_SECRET não estiver configurado (fail-closed).
# O padrão já é true — só setar false em sandbox sem secret configurado.
# WEBHOOK_REQUIRE_SIGNATURE=true

# ── Mercado Pago — PIX, cartão de crédito e boleto ──────────────────────────
# Access token da aplicação (mercadopago.com.br/developers > Suas integrações).
# Produção: APP_USR-... | Teste: TEST-... (define o ambiente; a BASE_URL é a
# mesma). Sem este valor, cartão/boleto respondem 503 e só o PIX fica ativo.
# A public key (par deste token) vai no frontend: VITE_MERCADO_PAGO_PUBLIC_KEY.
MERCADO_PAGO_ACCESS_TOKEN=
# URL pública deste backend enviada como notification_url em cada pagamento.
# Ex.: https://api.seudominio.com.br/api/pagamento/webhook/mercadopago
MERCADO_PAGO_WEBHOOK_URL=
# Opcional: assinatura secreta gerada na tela Webhooks do painel MP; habilita
# a validação do header x-signature nas notificações.
MERCADO_PAGO_WEBHOOK_SECRET=
# Janela de frescor (segundos) do ts assinado no x-signature (anti-replay);
# notificação com ts fora da janela é recusada. Default 300 (5 min); 0 desliga.
# MERCADO_PAGO_WEBHOOK_TOLERANCIA_SEGUNDOS=300
# Máximo de parcelas no cartão (default 12)
MERCADO_PAGO_MAX_PARCELAS=12
# MERCADO_PAGO_BASE_URL=https://api.mercadopago.com

# ── Melhor Envio — cálculo de frete (Sprint 7/Shipping) ──────────────────────
# Token de acesso gerado no painel do Melhor Envio (melhorenvio.com.br >
# Integrações > Permissões de acesso > Gerar novo token, escopo
# shipping-calculate). Sandbox: token do sandbox.melhorenvio.com.br +
# MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
# Sem token + CEP de origem, POST /api/frete/cotacao responde 503 e o
# checkout segue sem frete (entrega combinada pelo WhatsApp).
MELHOR_ENVIO_TOKEN=
# E-mail de contato técnico exigido no User-Agent das chamadas à API
MELHOR_ENVIO_CONTATO=
# CEP de onde os pedidos são despachados (só dígitos), ex. Ponta Grossa-PR
FRETE_CEP_ORIGEM=
# MELHOR_ENVIO_BASE_URL=https://melhorenvio.com.br
# Subtotal de itens a partir do qual a opção mais barata sai grátis (centavos)
# FRETE_GRATIS_MINIMO_CENTAVOS=30000
# Caixa padrão da cotação, em cm (o peso vem dos itens)
# FRETE_PACOTE_ALTURA_CM=15
# FRETE_PACOTE_LARGURA_CM=20
# FRETE_PACOTE_COMPRIMENTO_CM=20

# ── Backup do banco (scripts/backup_db.sh) ───────────────────────────────────
# Connection string do session pooler (Dashboard > Connect > Session pooler).
# Usada SÓ pelo script de backup — o backend não lê esta variável.
# SUPABASE_DB_URL=postgresql://postgres.PROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
# Criptografia do dump em repouso (LGPD — dados pessoais em claro). Configure UM
# método; sem nenhum, o dump sai em claro e o script avisa. Ver cabeçalho do
# script para restaurar.
# BACKUP_AGE_RECIPIENT=age1...            # chave pública age → .dump.age
# BACKUP_GPG_RECIPIENT=email-ou-keyid     # chave pública gpg → .dump.gpg
# BACKUP_GPG_PASSPHRASE=                  # gpg simétrico (senha) → .dump.gpg

# Pedido 'novo' sem pagamento aprovado é cancelado (com estoque devolvido)
# depois deste prazo, em horas. A varredura só roda com o Mercado Pago
# configurado; pedidos 'em_andamento' (WhatsApp) nunca expiram.
# PEDIDO_EXPIRA_HORAS=24
