SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key

# For admin operations (viewing orders, managing products from the API)
# use the service role key instead:
# SUPABASE_KEY=your-service-role-key

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# Pix payment key (CPF, phone, email, or random key)
PIX_KEY=sua-chave-pix@email.com
PIX_BENEFICIARIO=Carolina Viapiana

# ── API Pix Sicredi (Sprint 6) ────────────────────────────────────────────────
# Credenciais OAuth2 geradas no Portal do Desenvolvedor Sicredi
# (APIs > Catálogo de APIs > API Recebimento > Pix > Certificados e Credenciais).
# Sem estes valores, os endpoints de cobrança PIX respondem 503 e o site cai no
# fluxo antigo (combinar pagamento pelo WhatsApp).
SICREDI_CLIENT_ID=
SICREDI_CLIENT_SECRET=
# Certificado assinado pelo Sicredi + chave privada (APLICACAO.KEY), em PEM.
# Se o portal entregou .CER binário (DER), converta:
#   openssl x509 -inform der -in certificado.cer -out certificado.pem
SICREDI_CERT_PATH=/caminho/para/certificado.pem
SICREDI_KEY_PATH=/caminho/para/aplicacao.key
# Opcional: cadeia completa Sicredi (CA extra para verificação TLS)
SICREDI_CA_PATH=
# Produção: https://api-pix.sicredi.com.br | Homologação: https://api-pix-h.sicredi.com.br
SICREDI_BASE_URL=https://api-pix.sicredi.com.br
# URL pública deste backend para o webhook de confirmação; o Sicredi notifica
# em {PIX_WEBHOOK_URL}/pix. Registre com PUT /api/pagamento/webhook (staff).
# Ex.: https://api.seudominio.com.br/api/pagamento/webhook
PIX_WEBHOOK_URL=

# ── Mercado Pago — cartão de crédito + boleto (Sprint 7) ─────────────────────
# Access token da aplicação (mercadopago.com.br/developers > Suas integrações).
# Produção: APP_USR-... | Teste: TEST-... (define o ambiente; a BASE_URL é a
# mesma). Sem este valor, cartão/boleto respondem 503 e só o PIX fica ativo.
# A public key (par deste token) vai no frontend: VITE_MERCADO_PAGO_PUBLIC_KEY.
MERCADO_PAGO_ACCESS_TOKEN=
# URL pública deste backend enviada como notification_url em cada pagamento.
# Ex.: https://api.seudominio.com.br/api/pagamento/webhook/mercadopago
MERCADO_PAGO_WEBHOOK_URL=
# Opcional: assinatura secreta gerada na tela Webhooks do painel MP; habilita
# a validação do header x-signature nas notificações.
MERCADO_PAGO_WEBHOOK_SECRET=
# Máximo de parcelas no cartão (default 12)
MERCADO_PAGO_MAX_PARCELAS=12
# MERCADO_PAGO_BASE_URL=https://api.mercadopago.com

# ── Melhor Envio — cálculo de frete (Sprint 7/Shipping) ──────────────────────
# Token de acesso gerado no painel do Melhor Envio (melhorenvio.com.br >
# Integrações > Permissões de acesso > Gerar novo token, escopo
# shipping-calculate). Sandbox: token do sandbox.melhorenvio.com.br +
# MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
# Sem token + CEP de origem, POST /api/frete/cotacao responde 503 e o
# checkout segue sem frete (entrega combinada pelo WhatsApp).
MELHOR_ENVIO_TOKEN=
# E-mail de contato técnico exigido no User-Agent das chamadas à API
MELHOR_ENVIO_CONTATO=
# CEP de onde os pedidos são despachados (só dígitos), ex. Ponta Grossa-PR
FRETE_CEP_ORIGEM=
# MELHOR_ENVIO_BASE_URL=https://melhorenvio.com.br
# Subtotal de itens a partir do qual a opção mais barata sai grátis (centavos)
# FRETE_GRATIS_MINIMO_CENTAVOS=30000
# Caixa padrão da cotação, em cm (o peso vem dos itens)
# FRETE_PACOTE_ALTURA_CM=15
# FRETE_PACOTE_LARGURA_CM=20
# FRETE_PACOTE_COMPRIMENTO_CM=20

# ── Backup do banco (scripts/backup_db.sh) ───────────────────────────────────
# Connection string do session pooler (Dashboard > Connect > Session pooler).
# Usada SÓ pelo script de backup — o backend não lê esta variável.
# SUPABASE_DB_URL=postgresql://postgres.PROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Pedido 'novo' sem pagamento aprovado é cancelado (com estoque devolvido)
# depois deste prazo, em horas. A varredura só roda com Sicredi ou Mercado
# Pago configurados; pedidos 'em_andamento' (WhatsApp) nunca expiram.
# PEDIDO_EXPIRA_HORAS=24
